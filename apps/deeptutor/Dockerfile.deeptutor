FROM ghcr.io/hkuds/deeptutor:latest

# Increase file upload limits:
#   MAX_PDF_SIZE:  50 MB  → 2048 MB
#   MAX_FILE_SIZE: 100 MB → 2048 MB
RUN sed -i \
    's/MAX_PDF_SIZE: ClassVar\[int\] = 50 \* 1024 \* 1024/MAX_PDF_SIZE: ClassVar[int] = 2048 * 1024 * 1024/' \
    /app/deeptutor/utils/document_validator.py && \
    sed -i \
    's/MAX_FILE_SIZE: ClassVar\[int\] = 100 \* 1024 \* 1024/MAX_FILE_SIZE: ClassVar[int] = 2048 * 1024 * 1024/' \
    /app/deeptutor/utils/document_validator.py
