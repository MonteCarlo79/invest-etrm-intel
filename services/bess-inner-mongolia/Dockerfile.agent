FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN pip install --no-cache-dir \
    requests \
    tqdm \
    pandas \
    numpy \
    sqlalchemy>=2.0 \
    psycopg2-binary \
    openpyxl \
    python-dotenv

COPY services/bess-inner-mongolia/ /app/

CMD ["python", "run_agent.py"]
